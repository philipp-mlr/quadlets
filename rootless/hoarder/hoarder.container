[Unit]
Description=hoarder
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=hoarder
Image=ghcr.io/hoarder-app/hoarder:release
EnvironmentFile=hoarder.env

ExposeHostPort=3000

Network=t3_proxy

Volume=/mnt/cache/appdata/hoarder:/data

Label="traefik.enable=true"
## HTTP Routers
Label="traefik.http.routers.hoarder-rtr.entrypoints=websecure"
Label="traefik.http.routers.hoarder-rtr.rule=Host(`bookmarks.$DOMAINNAME`)"
## Middlewares
Label="traefik.http.routers.hoarder-rtr.middlewares=chain-authelia@file"
## HTTP Services
Label="traefik.http.routers.hoarder-rtr.service=hoarder-svc"
Label="traefik.http.services.hoarder-svc.loadbalancer.server.port=3000"

NoNewPrivileges=true

AutoUpdate=registry

Timezone=local

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
