[Unit]
Description=Actual Budget AI
Wants=network-online.target
After=network-online.target actual.service

[Container]
ContainerName=actual-ai
Image=docker.io/sakowicz/actual-ai:latest
EnvironmentFile=actual-ai.env

Network=t3_proxy

NoNewPrivileges=true

AutoUpdate=registry

Timezone=local

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
