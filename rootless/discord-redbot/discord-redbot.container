[Unit]
Description=Discord Redbot
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=discord-redbot
Image=docker.io/phasecorex/red-discordbot:latest
EnvironmentFile=./discord-redbot.env
Volume=$APPDATA_DIR/discord-redbot:/data
Network=t3_proxy

NoNewPrivileges=true

AutoUpdate=registry

Timezone=local

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
