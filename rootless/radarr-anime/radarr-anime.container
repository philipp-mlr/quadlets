[Unit]
Description=Radarr Anime Movie Management
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=radarr-anime
Image=lscr.io/linuxserver/radarr:latest
EnvironmentFile=./radarr-anime.env

Volume=$APPDATA_DIR/radarr-anime:/config
Volume=$MEDIA_DIR/metadata/radarr-anime:/config/MediaCover
Volume=$MEDIA_DIR/movies:/movies
Volume=$DOWNLOAD_DIR:/downloads

Network=t3_proxy

Label="traefik.enable=true"
## HTTP Routers Auth Bypass
Label="traefik.http.routers.radarr-anime-rtr-bypass.entrypoints=websecure"
Label="traefik.http.routers.radarr-anime-rtr-bypass.rule=Host(`radarr-anime.$DOMAINNAME`) && (Header(`X-Api-Key`, `$RADARR_API_KEY`) || Query(`apikey`, `$RADARR_API_KEY`))"
Label="traefik.http.routers.radarr-anime-rtr-bypass.priority=100"
## HTTP Routers
Label="traefik.http.routers.radarr-anime-rtr.entrypoints=websecure"
Label="traefik.http.routers.radarr-anime-rtr.rule=Host(`radarr-anime.$DOMAINNAME`)"
Label="traefik.http.routers.radarr-anime-rtr.priority=99"
## Middlewares
Label="traefik.http.routers.radarr-anime-rtr-bypass.middlewares=chain-no-auth@file"
Label="traefik.http.routers.radarr-anime-rtr.middlewares=chain-authelia@file"
## HTTP Services
Label="traefik.http.routers.radarr-anime-rtr.service=radarr-anime-svc"
Label="traefik.http.routers.radarr-anime-rtr-bypass.service=radarr-anime-svc"
Label="traefik.http.services.radarr-anime-svc.loadbalancer.server.port=7878"

NoNewPrivileges=true

AutoUpdate=registry

Timezone=local

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
