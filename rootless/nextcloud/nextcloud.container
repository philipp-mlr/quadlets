[Unit]
Description=Nextcloud 
Wants=network-online.target
After=network-online.target postgres-nextcloud.service redis-nextcloud.service

[Container]
ContainerName=nextcloud
Image=docker.io/nextcloud:latest
EnvironmentFile=nextcloud.env

Volume=$APPDATA_DIR/nextcloud/:/var/www/html

Network=t3_proxy

Secret=postgres_password,target=/run/secrets/postgres_password
Secret=nextcloud_admin_password,target=/run/secrets/nextcloud_admin_password
Secret=nextcloud_admin_user,target=/run/secrets/nextcloud_admin_user

Label="traefik.enable=true"
## HTTP Routers
Label="traefik.http.routers.nextcloud-rtr.entrypoints=websecure"
Label="traefik.http.routers.nextcloud-rtr.rule=Host(`cloud.$DOMAINNAME`)"
## Middlewares
Label="traefik.http.routers.nextcloud-rtr.middlewares=chain-nextcloud-no-auth@file"
## HTTP Services
Label="traefik.http.routers.nextcloud-rtr.service=nextcloud-svc"
Label="traefik.http.services.nextcloud-svc.loadbalancer.server.port=80"

NoNewPrivileges=true

AutoUpdate=registry

Timezone=local

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
