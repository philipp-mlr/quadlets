[Unit]
Description=Authelia Redis
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=redis-authelia
Image=docker.io/redis:latest

Network=t3_proxy

Volume=/mnt/cache/appdata/redis_authelia:/data

NoNewPrivileges=true

AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
