[Unit]
Description=Adguardhome
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=adguardhome
Image=docker.io/adguard/adguardhome

Network=host
PublishPort=53:53/tcp
PublishPort=53:53/udp
PublishPort=853:853/tcp
PublishPort=853:853/udp
PublishPort=22310:22310

#Network=macvlan0
#IP=192.168.2.150

Volume=$APPDATA_DIR/adguardhome/work:/opt/adguardhome/work
Volume=$APPDATA_DIR/adguardhome/conf:/opt/adguardhome/conf

NoNewPrivileges=true

AutoUpdate=registry

Timezone=local

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
