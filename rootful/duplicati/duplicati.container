[Unit]
Description=duplicati
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=duplicati
Image=lscr.io/linuxserver/duplicati:latest
EnvironmentFile=duplicati.env

Network=podman

Volume=$APPDATA_DIR/duplicati/config:/config

Volume=$APPDATA_DIR:$APPDATA_DIR:ro
Volume=$MEDIA_DIR:/mnt/disks/media:ro
Volume=/home/philipp:/home/philipp:ro

PublishPort=8200:8200

AutoUpdate=registry

Timezone=local

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
